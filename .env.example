# PostgreSQL connection (matches docker-compose.yml for local dev)
DATABASE_URL="postgresql://paylens:paylens@localhost:5432/paylens?schema=public"
# Direct (non-pooled) connection used by Prisma migrations. Locally this is the
# same as DATABASE_URL; on a pooled provider (e.g. Neon) set it to the unpooled
# endpoint. On Vercel, the Neon integration provisions both automatically.
DATABASE_URL_UNPOOLED="postgresql://paylens:paylens@localhost:5432/paylens?schema=public"
